---
// src/components/Footer.astro
---

<style>
  /* Guarantee perfect circles — no flex stretching */
  .social-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 36px !important;
    height: 36px !important;
    min-width: 36px !important;
    min-height: 36px !important;
    border-radius: 50% !important;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    transition: all 0.3s ease;
    backdrop-filter: blur(8px);
    text-decoration: none;
  }
  .social-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(7, 190, 232, 0.3);
  }
  .social-btn.instagram:hover {
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
    border-color: transparent;
    color: #fff;
  }
  .social-btn.facebook:hover {
    background: #1877F2;
    border-color: #1877F2;
    color: #fff;
  }
  .social-btn.youtube:hover {
    background: #FF0000;
    border-color: #FF0000;
    color: #fff;
  }
  @media (min-width: 640px) {
    .social-btn {
      width: 40px !important;
      height: 40px !important;
      min-width: 40px !important;
      min-height: 40px !important;
    }
  }
</style>

<footer class="bg-gradient-to-b from-[#023579] via-[#024095] to-[#012456] text-white pt-14 sm:pt-22 pb-10 border-t-4 border-[#07bee8] relative z-10 overflow-hidden">
  <!-- Subtle ambient lighting -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-[#07bee8]/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-10 w-96 h-96 bg-[#07bee8]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">

    <!-- Top Consultation Banner -->
    <div class="mb-12 p-6 sm:p-8 rounded-2xl bg-white/10 border border-white/20 flex flex-col md:flex-row items-center justify-between gap-6 shadow-2xl backdrop-blur-md">
      <div class="space-y-1 text-center md:text-left">
        <span class="text-[10px] font-mono font-extrabold uppercase tracking-[0.3em] text-[#07bee8]">Custom Water Engineering</span>
        <h3 class="text-xl sm:text-2xl font-black text-white uppercase tracking-tight">Need Water Testing &amp; Custom Systems?</h3>
        <p class="text-xs sm:text-sm text-blue-100 font-light">Consult with our Kerala water chemistry engineers today.</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 shrink-0">
        <a href="/contact" class="px-6 py-3 bg-[#07bee8] text-slate-950 text-xs font-black uppercase tracking-wider rounded-xl hover:bg-white transition-all shadow-lg shadow-[#07bee8]/20 active:scale-95">
          Request Consultation &rarr;
        </a>
        <a href="tel:+919645830994" class="px-6 py-3 border-2 border-white/60 text-white hover:bg-white hover:text-[#024095] text-xs font-black uppercase tracking-wider rounded-xl transition-all active:scale-95">
          +91 96458 30994
        </a>
      </div>
    </div>

    <!-- Main Navigation Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-12 border-b border-white/15">

      <!-- Column 1: Original Logo Card & Brand Info (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-block">
          <div class="bg-white p-2.5 sm:p-3 rounded-xl shadow-md border border-white/80 inline-block">
            <img src="/images/company logo/SAMUDHRA WATER SOLUTIONS LOGO PNG.png" alt="Samudhra Water Solutions" class="h-10 sm:h-12 w-auto object-contain" />
          </div>
        </a>
        <p class="text-xs text-blue-100 font-light leading-relaxed max-w-sm">
          Customized water treatment solutions for homes, businesses, and industrial facilities across Kerala. Over 16 years of water engineering expertise.
        </p>
        
        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-2 pt-1">
          <span class="px-3 py-1 bg-white/15 border border-white/20 text-[#07bee8] text-[10px] font-extrabold uppercase tracking-wider rounded-md backdrop-blur-sm">
            ISO 9001:2015 Certified
          </span>
          <span class="px-3 py-1 bg-white/15 border border-white/20 text-white text-[10px] font-extrabold uppercase tracking-wider rounded-md backdrop-blur-sm">
            16+ Years Experience
          </span>
        </div>

        <!-- Social Media Buttons -->
        <div class="pt-2">
          <p class="text-[10px] font-mono text-[#07bee8] font-extrabold uppercase tracking-widest mb-3">Connect With Us</p>
          <div class="flex items-center gap-2.5">
            <a href="https://www.instagram.com/samudhra_water_solutions?igsh=c2dobW5sNXI1ZDc="
               target="_blank" rel="noopener noreferrer"
               aria-label="Follow Samudhra on Instagram"
               class="social-btn instagram">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://www.facebook.com/samudhrasolutions"
               target="_blank" rel="noopener noreferrer"
               aria-label="Follow Samudhra on Facebook"
               class="social-btn facebook">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://youtube.com/@samudhrawatersolutions?si=HGWyepM9F6-N5EkB"
               target="_blank" rel="noopener noreferrer"
               aria-label="Subscribe to Samudhra on YouTube"
               class="social-btn youtube">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Column 2: Company Pages (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <p class="text-xs font-mono font-extrabold uppercase tracking-[0.25em] text-[#07bee8]">Company Pages</p>
        <ul class="space-y-2.5 text-xs font-bold uppercase tracking-wider">
          <li>
            <a href="/" class="text-white hover:text-[#07bee8] transition-colors flex items-center gap-2 group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#07bee8] group-hover:scale-125 transition-transform"></span>
              Home Page
            </a>
          </li>
          <li>
            <a href="/about" class="text-white/90 hover:text-[#07bee8] transition-colors flex items-center gap-2 group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#07bee8]/60 group-hover:bg-[#07bee8] transition-colors"></span>
              About Us
            </a>
          </li>
          <li>
            <a href="/founder" class="text-white/90 hover:text-[#07bee8] transition-colors flex items-center gap-2 group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#07bee8]/60 group-hover:bg-[#07bee8] transition-colors"></span>
              Founder Message
            </a>
          </li>
          <li>
            <a href="/testimonial" class="text-white/90 hover:text-[#07bee8] transition-colors flex items-center gap-2 group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#07bee8]/60 group-hover:bg-[#07bee8] transition-colors"></span>
              Client Testimonials
            </a>
          </li>
          <li>
            <a href="/blog" class="text-white/90 hover:text-[#07bee8] transition-colors flex items-center gap-2 group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#07bee8]/60 group-hover:bg-[#07bee8] transition-colors"></span>
              Articles &amp; Insights
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Solutions & Shop (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <p class="text-xs font-mono font-extrabold uppercase tracking-[0.25em] text-[#07bee8]">Solutions</p>
        <ul class="space-y-2.5 text-xs font-bold uppercase tracking-wider">
          <li>
            <a href="/service" class="text-white/90 hover:text-[#07bee8] transition-colors flex items-center gap-2 group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#07bee8]/60 group-hover:bg-[#07bee8] transition-colors"></span>
              Our Services
            </a>
          </li>
          <li>
            <a href="/shop" class="text-white/90 hover:text-[#07bee8] transition-colors flex items-center gap-2 group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#07bee8]/60 group-hover:bg-[#07bee8] transition-colors"></span>
              Products Shop
            </a>
          </li>
          <li>
            <a href="/contact" class="text-white/90 hover:text-[#07bee8] transition-colors flex items-center gap-2 group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#07bee8]/60 group-hover:bg-[#07bee8] transition-colors"></span>
              Contact Hub
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Contact & Direct Support (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <p class="text-xs font-mono font-extrabold uppercase tracking-[0.25em] text-[#07bee8]">Contact &amp; Support</p>
        <div class="space-y-3 text-xs text-white">
          <div class="flex items-start gap-3 bg-white/10 p-3.5 rounded-xl border border-white/15 backdrop-blur-sm">
            <svg class="w-4 h-4 text-[#07bee8] shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <div class="space-y-2 w-full">
              <p class="text-[10px] font-mono text-[#07bee8] font-bold uppercase tracking-wider">Phone Support Lines</p>
              <div>
                <span class="text-[10px] text-blue-200 block font-medium">General Support &amp; Sales:</span>
                <a href="tel:+919645830994" class="font-bold text-white hover:text-[#07bee8] transition-colors block text-xs">+91 96458 30994</a>
              </div>
              <div class="pt-1.5 border-t border-white/10">
                <span class="text-[10px] text-red-300 block font-semibold">24/7 Emergency Line:</span>
                <a href="tel:+919656830994" class="font-bold text-white hover:text-[#07bee8] transition-colors block text-xs">+91 96568 30994</a>
              </div>
            </div>
          </div>

          <div class="flex items-start gap-3 bg-white/10 p-3.5 rounded-xl border border-white/15 backdrop-blur-sm">
            <svg class="w-4 h-4 text-[#07bee8] shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <div class="space-y-1 overflow-hidden">
              <p class="text-[10px] font-mono text-[#07bee8] font-bold uppercase tracking-wider">Email Enquiries</p>
              <a href="mailto:mail@samudhra.co.in" class="font-semibold text-white hover:text-[#07bee8] transition-colors block text-[11px] truncate">mail@samudhra.co.in</a>
              <a href="mailto:info.samudhra10@gmail.com" class="font-semibold text-white hover:text-[#07bee8] transition-colors block text-[11px] truncate">info.samudhra10@gmail.com</a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-semibold text-blue-100">
      <p>&copy; {new Date().getFullYear()} <strong class="text-white">Samudhra Water Solutions</strong>. All Rights Reserved.</p>
      <div class="flex items-center gap-6 text-[11px] uppercase tracking-wider font-extrabold">
        <span class="text-[#07bee8]">ISO 9001:2015 Certified</span>
        <span class="text-white/90">Trivandrum, Kerala</span>
        <button onclick="window.scrollTo({top:0, behavior:'smooth'})" class="text-white hover:text-[#07bee8] transition-colors cursor-pointer flex items-center gap-1">
          Back to top &uarr;
        </button>
      </div>
    </div>

  </div>
</footer>
