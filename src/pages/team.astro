---
// src/pages/team.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const teamPhotos = [
  {
    title: "Field Engineering & Team Assessment",
    subtitle: "On-Site Water Treatment Installation",
    image: "/images/team/DSC06080.JPG",
    description: "Our core engineering team reviewing plant parameters during site installation in Trivandrum.",
    tag: "FIELD ENGINEERING"
  },
  {
    title: "Technical Field Operations & Quality Testing",
    subtitle: "System Calibration & Maintenance",
    image: "/images/team/DSC06084%20(1).JPG",
    description: "Field technical squad conducting water quality checks and system flow diagnostics.",
    tag: "SITE OPERATIONS"
  },
  {
    title: "Water Chemistry & Digital System Architecture",
    subtitle: "Custom Plant CAD & Test Analysis",
    image: "/images/team/Laptop.jpeg",
    description: "Technical design team configuring custom filtration plant specifications tailored to Kerala water source metrics.",
    tag: "DESIGN & LAB"
  }
];
---

<Layout 
  title="Our Expert Team | Samudhra Water Solutions"
  description="Meet the certified process engineers, water treatment specialists, and field technicians at Samudhra Water Solutions Kerala."
  canonicalUrl={Astro.url.href}
>
  <Navbar />

  <!-- HERO HEADER -->
  <section class="bg-[#FAF9F6] text-slate-900 pt-28 sm:pt-36 pb-16 sm:pb-20 border-b border-slate-200/60 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center relative z-10">
      <span class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-[0.35em] text-[#07bee8] block mb-3">
        EXPERT WATER SPECIALISTS &amp; ENGINEERS
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[#024095] uppercase leading-tight max-w-4xl mx-auto">
        Meet The Team <br class="hidden sm:block" />Behind Samudhra Water Solutions
      </h1>
      <p class="text-sm sm:text-lg text-slate-600 font-light mt-6 max-w-2xl mx-auto leading-relaxed">
        Our dedicated team of certified water process engineers, lab specialists, and field technicians bring over 15+ years of experience (Est. 2009) delivering pure, safe water solutions across Kerala.
      </p>
    </div>
  </section>

  <!-- FOUNDER & MANAGING DIRECTOR SPOTLIGHT -->
  <section class="py-12 sm:py-16 bg-[#FAF9F6] border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-10 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Founder Portrait Column -->
          <div class="lg:col-span-5 group cursor-pointer" onclick="openLightbox('/images/founder.jpeg', 'Rajesh Kumar V K — Founder & Managing Director')">
            <div class="relative rounded-2xl overflow-hidden border border-slate-200 shadow-xl aspect-[4/5] bg-slate-100">
              <span class="absolute top-4 left-4 z-10 px-3 py-1 bg-[#024095] text-white text-[10px] font-black uppercase tracking-wider rounded-md shadow-md">
                FOUNDER &amp; MANAGING DIRECTOR
              </span>
              <img 
                src="/images/founder.jpeg" 
                alt="Rajesh Kumar V K — Founder & Managing Director" 
                class="w-full h-full object-cover object-[center_35%] group-hover:scale-105 transition-transform duration-700 ease-out" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-6">
                <span class="px-4 py-2 bg-white/90 text-[#024095] text-xs font-black uppercase tracking-wider rounded-full shadow-lg flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                  Click to Enlarge Photo
                </span>
              </div>
            </div>
          </div>

          <!-- Founder Bio & Leadership Mention -->
          <div class="lg:col-span-7 flex flex-col gap-6">
            <div>
              <span class="text-[10px] font-mono text-[#07bee8] font-extrabold uppercase tracking-[0.3em] block mb-2">FOUNDERSHIP &amp; STRATEGIC VISION</span>
              <h2 class="text-2xl sm:text-4xl font-black text-[#024095] uppercase tracking-tight leading-tight">
                Rajesh Kumar V K
              </h2>
              <p class="text-xs sm:text-sm font-bold text-slate-500 uppercase tracking-wider mt-1">Founder &amp; Managing Director</p>
            </div>

            <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-[#07bee8]/10 border border-[#07bee8]/30 text-[#024095] text-xs font-extrabold uppercase tracking-wider rounded-lg w-fit">
              <span class="w-2 h-2 rounded-full bg-[#07bee8]"></span>
              15+ Years Domain Leadership (Est. 2009)
            </div>

            <p class="text-xs sm:text-sm text-slate-600 font-light leading-relaxed">
              Pioneered customized water treatment engineering across Kerala. Under the leadership of Rajesh Kumar V K, Samudhra Water Solutions has configured over 5,000+ custom RO plants, iron removal systems, and zero-discharge recycling units tailored specifically to Kerala's ground water parameters.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 border-t border-slate-100 pt-4">
              <div class="flex items-center gap-2 text-xs font-bold text-slate-800">
                <svg class="w-4 h-4 text-[#07bee8]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                <span>ISO 9001:2015 Certified Quality</span>
              </div>
              <div class="flex items-center gap-2 text-xs font-bold text-slate-800">
                <svg class="w-4 h-4 text-[#07bee8]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                <span>MSME Day Award Winner 2026</span>
              </div>
            </div>

            <div class="pt-2">
              <a href="/founder" class="inline-flex items-center justify-center min-h-[44px] px-6 py-2.5 bg-[#024095] hover:bg-[#07bee8] text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all shadow-md active:scale-95">
                Read Full Founder Profile &rarr;
              </a>
            </div>

          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- ON-SITE TEAM WORK SHOWCASE GALLERY -->
  <section class="py-16 sm:py-24 bg-white border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-left mb-12 max-w-3xl">
        <span class="text-xs font-mono text-[#07bee8] font-black uppercase tracking-[0.25em] block mb-2">Team In Action</span>
        <h2 class="text-3xl font-black text-[#024095] uppercase tracking-tight">
          Field Operations <span class="text-[#07bee8]"> &amp; Technical Work</span>
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-3 font-light leading-relaxed">
          Take a look behind the scenes at our team performing site assessments, water chemistry evaluations, system CAD designs, and plant installations across Kerala.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {teamPhotos.map((photo) => (
          <div 
            class="bg-[#FAF9F6] rounded-3xl border border-slate-200/80 overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 group cursor-pointer flex flex-col justify-between" 
            onclick={`openLightbox('${photo.image}', '${photo.title} - ${photo.subtitle}')`}
          >
            <div>
              <div class="aspect-[16/10] overflow-hidden bg-slate-200 relative">
                <span class="absolute top-3 left-3 z-10 px-2.5 py-1 bg-[#024095] text-white text-[9px] font-black uppercase tracking-wider rounded-md shadow-md">
                  {photo.tag}
                </span>
                <img 
                  src={photo.image} 
                  alt={photo.title} 
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out" 
                />
                <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                  <span class="px-4 py-2 rounded-full bg-white/90 text-[#024095] text-xs font-black uppercase tracking-wider shadow-lg flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                    Click to View Full Size
                  </span>
                </div>
              </div>
              <div class="p-6 bg-white border-t border-slate-100">
                <span class="text-[10px] font-mono text-[#07bee8] font-bold uppercase tracking-wider block mb-1">{photo.subtitle}</span>
                <h3 class="text-lg font-black text-[#024095] uppercase tracking-tight">{photo.title}</h3>
                <p class="text-xs text-slate-600 font-light leading-relaxed mt-2">{photo.description}</p>
              </div>
            </div>
            <div class="p-6 pt-0 bg-white">
              <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-[#024095] group-hover:text-[#07bee8] transition-colors pt-3 border-t border-slate-100 w-full">
                <span>View Operational Photo</span>
                <span>&rarr;</span>
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ENGINEERING VALUES & IMPACT STATS BAR -->
  <section class="py-12 bg-[#FAF9F6] border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <p class="text-3xl sm:text-4xl font-black text-[#024095] mb-1">5,000+</p>
          <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">Custom Water Plants Installed</p>
        </div>
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <p class="text-3xl sm:text-4xl font-black text-[#07bee8] mb-1">15+ Years</p>
          <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">Kerala Field Experience (Est. 2009)</p>
        </div>
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <p class="text-3xl sm:text-4xl font-black text-[#024095] mb-1">100%</p>
          <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">Source Water Tested &amp; Calibrated</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX MODAL -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 transition-opacity duration-300">
    <button 
      id="lightbox-close" 
      class="absolute top-4 right-4 sm:top-6 sm:right-6 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 rounded-full p-3 transition-all z-10"
      aria-label="Close modal"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <div class="max-w-4xl max-h-[90vh] flex flex-col items-center justify-center">
      <img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-full object-contain rounded-xl shadow-2xl" />
      <p id="lightbox-caption" class="text-white/90 text-xs sm:text-sm font-semibold mt-4 text-center tracking-wide bg-slate-900/80 px-6 py-2 rounded-full border border-white/10"></p>
    </div>
  </div>

  <script is:inline>
    function openLightbox(src, caption) {
      const modal = document.getElementById('lightbox-modal');
      const img = document.getElementById('lightbox-img');
      const cap = document.getElementById('lightbox-caption');
      if (modal && img && cap) {
        img.src = src;
        cap.textContent = caption;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('lightbox-modal');
      const closeBtn = document.getElementById('lightbox-close');
      if (closeBtn && modal) {
        closeBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        });
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }
        });
      }
    });
  </script>

  <!-- CTA FOOTER -->
  <section class="py-16 sm:py-20 bg-[#024095] text-white">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-6">
      <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight">Need Expert Advice on Your Water Quality?</h2>
      <p class="text-sm sm:text-base text-blue-100 font-light leading-relaxed max-w-xl mx-auto">
        Speak directly with our senior process engineers for a free site assessment and customized water treatment quotation.
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <a href="/contact" class="px-8 py-3.5 bg-[#07bee8] text-[#024095] font-black text-xs uppercase tracking-widest rounded-xl hover:bg-white transition-all shadow-lg">
          Book Free Water Testing
        </a>
        <a href="tel:+919645830994" class="px-8 py-3.5 bg-white/10 border-2 border-white/80 text-white font-black text-xs uppercase tracking-widest rounded-xl hover:bg-white hover:text-[#024095] transition-all">
          Call Senior Engineer
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>



