---
// src/pages/program.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const programs = [
  {
    title: "Clean School Water Initiative",
    tag: "COMMUNITY & EDUCATION",
    description: "Providing subsidized, high-capacity UV/UF filtration and iron removal systems for schools across Trivandrum and Kerala to ensure safe drinking water for students.",
    highlights: ["Free Source Water Testing", "Subsidized Plant Installation", "Annual Maintenance Included"]
  },
  {
    title: "Community Borewell Purification Drive",
    tag: "PUBLIC HEALTH",
    description: "Partnering with local self-governments, Panchayats, and resident associations to install centralized community iron removal and water softening plants.",
    highlights: ["KSPCB Norms Compliant", "Multi-Stage Iron Removal", "High-Volume Output"]
  },
  {
    title: "Zero Wastewater & STP Recycling Program",
    tag: "ENVIRONMENT & SUSTAINABILITY",
    description: "Assisting apartment complexes, hotels, and industrial facilities in deploying zero-discharge STP/ETP systems to reclaim up to 80% of wastewater for landscaping and non-potable reuse.",
    highlights: ["MBBR / MBR Technology", "Water Reuse Ready", "Full KSPCB Paperwork Support"]
  },
  {
    title: "Doorstep Water Audit & AMC Program",
    tag: "RESIDENTIAL CARE",
    description: "Comprehensive home water testing, filter health inspection, and scheduled annual maintenance contracts (AMC) for all major domestic water purifier brands.",
    highlights: ["Genuine Multibrand Spares", "Doorstep Lab Testing", "24/7 Priority Support"]
  }
];
---

<Layout 
  title="Samudhra Water Programs | Initiatives & Community Drives"
  description="Discover Samudhra Water Solutions programs including MSME Industrial Excellence, Clean School Water, Community Borewell Drives, and Zero Wastewater Recycling across Kerala."
  canonicalUrl={Astro.url.href}
>
  <Navbar />

  <!-- HERO HEADER -->
  <section class="bg-[#FAF9F6] text-slate-900 pt-28 sm:pt-36 pb-16 sm:pb-20 border-b border-slate-200/60 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center relative z-10">
      <span class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-[0.35em] text-[#07bee8] block mb-3">
        SUSTAINABLE WATER INITIATIVES
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[#024095] uppercase leading-tight max-w-4xl mx-auto">
        Samudhra Water Purification &amp; Community Programs
      </h1>
      <p class="text-sm sm:text-lg text-slate-600 font-light mt-6 max-w-2xl mx-auto leading-relaxed">
        Engineered water treatment programs for schools, communities, residential complexes, and industrial facilities across Kerala.
      </p>
    </div>
  </section>

  <!-- FEATURED PROGRAM: MSME DAY AWARD 2026 & STATE RECOGNITION -->
  <section class="bg-slate-900 text-white py-16 sm:py-24 border-t border-slate-800 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#07bee8]/10 rounded-full blur-3xl pointer-events-none -mr-40 -mt-40"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[#024095]/20 rounded-full blur-3xl pointer-events-none -ml-40 -mb-40"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <span class="text-xs font-mono text-[#07bee8] font-extrabold uppercase tracking-[0.25em] block mb-2">FLAGSHIP STATE PROGRAM</span>
          <h2 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
            MSME Day Industrial Excellence <span class="text-[#07bee8]">Program</span>
          </h2>
          <p class="text-slate-400 text-xs sm:text-sm mt-3 font-light max-w-2xl leading-relaxed">
            Conferred the MSME Day Award 2026 by the Kerala State Small Industries Association (KSSIA) celebrating industrial innovation, quality standards, and water treatment engineering excellence.
          </p>
        </div>
        <div class="shrink-0">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#07bee8]/10 border border-[#07bee8]/30 text-[#07bee8] text-xs font-bold uppercase tracking-wider">
            State Industry Honor
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-slate-800/60 border border-slate-700/80 rounded-3xl p-6 sm:p-8 backdrop-blur-sm shadow-2xl">
        <!-- Award Image Showcase -->
        <div class="lg:col-span-6 group cursor-pointer" onclick="openLightbox('/images/founder6.jpeg', 'Mr. Rajesh Kumar V K receiving MSME Day Award 2026 from KSSIA')">
          <div class="relative rounded-2xl overflow-hidden border border-slate-700/80 shadow-2xl bg-[#021434]">
            <img 
              src="/images/founder6.jpeg" 
              alt="Mr. Rajesh Kumar V K receiving MSME Day Award 2026" 
              class="w-full h-auto max-h-[500px] object-contain mx-auto group-hover:scale-105 transition-transform duration-700 ease-out" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-6">
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-md rounded-full text-white text-xs font-bold uppercase tracking-wider border border-white/30">
                Click to Enlarge Award Photo
              </span>
            </div>
          </div>
        </div>

        <!-- Citation & Details -->
        <div class="lg:col-span-6 flex flex-col gap-6 text-slate-200">
          <div class="space-y-3">
            <span class="text-[10px] font-mono text-[#07bee8] uppercase tracking-[0.3em] font-extrabold">State Program Citation</span>
            <h3 class="text-xl sm:text-2xl font-bold text-white leading-snug">
              "Advancing Water Engineering Standards Across Kerala"
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 font-light leading-relaxed">
              Under this state-recognized initiative, Samudhra Water Solutions delivers custom industrial RO plants, iron removal systems, and zero-discharge recycling networks tailored for small and medium enterprises throughout Kerala.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-slate-700/80 pt-6">
            <div class="bg-slate-900/70 p-4 rounded-xl border border-slate-700/60">
              <p class="text-[10px] font-mono text-[#07bee8] font-bold uppercase tracking-wider mb-1">Presented By</p>
              <p class="text-xs font-bold text-white">Shri V. D. Satheesan</p>
              <p class="text-[10px] text-slate-400">Hon'ble Chief Minister of Kerala</p>
            </div>
            <div class="bg-slate-900/70 p-4 rounded-xl border border-slate-700/60">
              <p class="text-[10px] font-mono text-[#07bee8] font-bold uppercase tracking-wider mb-1">Distinguished Guests</p>
              <p class="text-xs font-bold text-white">Shri P. K. Kunhalikutty</p>
              <p class="text-[10px] text-slate-400">Minister for Industries, Govt. of Kerala</p>
            </div>
          </div>

          <div class="bg-gradient-to-r from-[#024095]/40 to-[#07bee8]/20 p-4 rounded-xl border border-[#07bee8]/30">
            <p class="text-xs text-white/90 italic leading-relaxed">
              "This initiative reinforces our mission to ensure sustainable water access and KSPCB-compliant purification for every enterprise."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED PROGRAM VIDEOS SHOWCASE (2 VIDEOS) -->
  <section class="py-16 sm:py-24 bg-white border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-left mb-12 max-w-3xl">
        <span class="text-xs font-mono text-[#07bee8] font-black uppercase tracking-[0.25em] block mb-2">FIELD DEMONSTRATIONS</span>
        <h2 class="text-3xl font-black text-[#024095] uppercase tracking-tight">
          Watch Our Water Programs <span class="text-[#07bee8]">In Action</span>
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-3 font-light leading-relaxed">
          See live field demonstrations, system calibrations, and community purification drives conducted by our process engineers across Kerala.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
        
        <!-- Video 1 Card -->
        <div class="bg-[#FAF9F6] rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-md flex flex-col justify-between">
          <div>
            <div class="flex justify-center mb-6">
              <div class="relative w-full max-w-[320px] aspect-[9/16] rounded-2xl overflow-hidden border-2 border-slate-200 shadow-xl bg-black">
                <iframe 
                  class="w-full h-full"
                  src="https://www.youtube.com/embed/3GvK3hj1IcU" 
                  title="Samudhra Sangamam Video" 
                  frameborder="0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                  allowfullscreen
                ></iframe>
              </div>
            </div>
            <div>
              <span class="text-[10px] font-mono text-[#07bee8] font-bold uppercase tracking-wider block mb-1">SAMUDHRA SANGAMAM</span>
              <h3 class="text-lg font-black text-[#024095] uppercase tracking-tight">Samudhra Sangamam</h3>
              <p class="text-xs text-slate-600 font-light leading-relaxed mt-2">
                Live field video highlights from our annual community water conference and purification initiative.
              </p>
            </div>
          </div>
          <div class="pt-6 border-t border-slate-200/60 mt-6">
            <a href="https://wa.me/919645830994?text=Hi%2C+I+watched+your+Samudhra+Sangamam+video.+I+would+like+to+book+a+free+water+testing." target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center min-h-[44px] bg-[#024095] hover:bg-[#07bee8] text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all shadow-md active:scale-95">
              Book Free Water Testing &rarr;
            </a>
          </div>
        </div>

        <!-- Video 2 Card -->
        <div class="bg-[#FAF9F6] rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-md flex flex-col justify-between">
          <div>
            <div class="flex justify-center mb-6">
              <div class="relative w-full max-w-[320px] aspect-[9/16] rounded-2xl overflow-hidden border-2 border-slate-200 shadow-xl bg-black">
                <iframe 
                  class="w-full h-full"
                  src="https://www.youtube.com/embed/zWQ1ebqSS7w" 
                  title="Samudhra Water Purification Program Video 2" 
                  frameborder="0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                  allowfullscreen
                ></iframe>
              </div>
            </div>
            <div>
              <span class="text-[10px] font-mono text-[#07bee8] font-bold uppercase tracking-wider block mb-1">FIELD DEMONSTRATION 02</span>
              <h3 class="text-lg font-black text-[#024095] uppercase tracking-tight">Community Water Treatment &amp; On-Site Support</h3>
              <p class="text-xs text-slate-600 font-light leading-relaxed mt-2">
                Highlights from community borewell purification drives, school filtration installations, and doorstep maintenance.
              </p>
            </div>
          </div>
          <div class="pt-6 border-t border-slate-200/60 mt-6">
            <a href="https://wa.me/919645830994?text=Hi%2C+I+watched+your+program+video+2.+I+would+like+to+inquire+about+community+water+treatment." target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center min-h-[44px] bg-[#024095] hover:bg-[#07bee8] text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all shadow-md active:scale-95">
              Inquire About Community Drive &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- PROGRAM LIST SECTION -->
  <section class="py-16 sm:py-24 bg-[#FAF9F6] border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-left mb-12">
        <span class="text-xs font-mono text-[#07bee8] font-black uppercase tracking-[0.25em] block mb-2">Community &amp; Institutional Drives</span>
        <h2 class="text-3xl font-black text-[#024095] uppercase tracking-tight">
          Active Water <span class="text-[#07bee8]">Programs</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {programs.map((prog) => (
          <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
            <div>
              <!-- Tag & ISO Badge Header -->
              <div class="flex items-center justify-between mb-4 gap-2 flex-wrap">
                <span class="px-3 py-1 bg-[#024095]/10 text-[#024095] text-[10px] font-black uppercase tracking-wider rounded-lg border border-[#024095]/20">
                  {prog.tag}
                </span>
                <span class="text-[10px] font-bold text-[#07bee8] uppercase tracking-wider font-mono">ISO 9001:2015 Program</span>
              </div>

              <!-- Content Area -->
              <h3 class="text-xl font-black text-[#024095] uppercase tracking-tight mb-3">{prog.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 font-light leading-relaxed mb-6">{prog.description}</p>
              
              <div class="space-y-2.5 border-t border-slate-100 pt-5 mb-6">
                {prog.highlights.map((h) => (
                  <div class="flex items-center gap-2.5 text-xs font-bold text-slate-800">
                    <div class="w-5 h-5 rounded-full bg-[#07bee8]/10 text-[#07bee8] flex items-center justify-center shrink-0">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span>{h}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
              <a href="/contact" class="w-full inline-flex items-center justify-center min-h-[46px] bg-[#024095] hover:bg-[#07bee8] text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all shadow-md active:scale-95">
                Enroll / Inquire About Program &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGRAM IMPACT STATS BAR -->
  <section class="py-12 bg-white border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-slate-200/80">
          <p class="text-3xl sm:text-4xl font-black text-[#024095] mb-1">100+</p>
          <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">Schools Benefited</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-slate-200/80">
          <p class="text-3xl sm:text-4xl font-black text-[#07bee8] mb-1">25+</p>
          <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">Panchayats Covered</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-slate-200/80">
          <p class="text-3xl sm:text-4xl font-black text-[#024095] mb-1">50M+</p>
          <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">Liters Purified Daily</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-slate-200/80">
          <p class="text-3xl sm:text-4xl font-black text-[#07bee8] mb-1">100%</p>
          <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">KSPCB Norm Compliant</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAM ENROLLMENT & CONSULTATION -->
  <section class="py-16 sm:py-24 bg-[#FAF9F6]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-6">
      <span class="text-[10px] font-mono text-[#07bee8] font-extrabold uppercase tracking-[0.3em]">PARTNER WITH SAMUDHRA</span>
      <h2 class="text-2xl sm:text-4xl font-black text-[#024095] uppercase leading-tight">
        Bring a Water Purification Program to Your Community or School
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 font-light leading-relaxed max-w-2xl mx-auto">
        Contact our program coordinator team to request a free site water audit and program proposal for your institution or Panchayath.
      </p>
      <div class="pt-4 flex justify-center gap-4">
        <a href="/contact" class="px-8 py-3.5 bg-[#024095] text-white font-black text-xs uppercase tracking-widest rounded-xl hover:bg-[#07bee8] transition-all shadow-md active:scale-95">
          Request Program Proposal
        </a>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX MODAL -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 transition-opacity duration-300">
    <button 
      id="lightbox-close" 
      class="absolute top-4 right-4 sm:top-6 sm:right-6 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 rounded-full p-3 transition-all z-10"
      aria-label="Close modal"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <div class="max-w-4xl max-h-[90vh] flex flex-col items-center justify-center">
      <img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-full object-contain rounded-xl shadow-2xl" />
      <p id="lightbox-caption" class="text-white/90 text-xs sm:text-sm font-semibold mt-4 text-center tracking-wide bg-slate-900/80 px-6 py-2 rounded-full border border-white/10"></p>
    </div>
  </div>

  <script is:inline>
    function openLightbox(src, caption) {
      const modal = document.getElementById('lightbox-modal');
      const img = document.getElementById('lightbox-img');
      const cap = document.getElementById('lightbox-caption');
      if (modal && img && cap) {
        img.src = src;
        cap.textContent = caption;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('lightbox-modal');
      const closeBtn = document.getElementById('lightbox-close');
      if (closeBtn && modal) {
        closeBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        });
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }
        });
      }
    });
  </script>

  <Footer />
</Layout>


