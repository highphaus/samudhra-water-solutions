---
// src/pages/program.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const programs = [
  {
    title: "Clean School Water Initiative",
    tag: "COMMUNITY & EDUCATION",
    description: "Providing subsidized, high-capacity UV/UF filtration and iron removal systems for schools across Trivandrum and Kerala to ensure safe drinking water for students.",
    icon: "/images/products/Uf%20Plant.jpg",
    highlights: ["Free Source Water Testing", "Subsidized Plant Installation", "Annual Maintenance Included"]
  },
  {
    title: "Community Borewell Purification Drive",
    tag: "PUBLIC HEALTH",
    description: "Partnering with local self-governments, Panchayats, and resident associations to install centralized community iron removal and water softening plants.",
    icon: "/images/products/Iron%20Remover%20Plant%20IRP.jpg",
    highlights: ["KSPCB Norms Compliant", "Multi-Stage Iron Removal", "High-Volume Output"]
  },
  {
    title: "Zero Wastewater & STP Recycling Program",
    tag: "ENVIRONMENT & SUSTAINABILITY",
    description: "Assisting apartment complexes, hotels, and industrial facilities in deploying zero-discharge STP/ETP systems to reclaim up to 80% of wastewater for landscaping and non-potable reuse.",
    icon: "/images/products/Sewage%20Treatment%20Plant.jpg",
    highlights: ["MBBR / MBR Technology", "Water Reuse Ready", "Full KSPCB Paperwork Support"]
  },
  {
    title: "Doorstep Water Audit & AMC Program",
    tag: "RESIDENTIAL CARE",
    description: "Comprehensive home water testing, filter health inspection, and scheduled annual maintenance contracts (AMC) for all major domestic water purifier brands.",
    icon: "/images/products/Aquaguard%20Water%20Purifiers.jpeg",
    highlights: ["Genuine Multibrand Spares", "Doorstep Lab Testing", "24/7 Priority Support"]
  }
];
---

<Layout 
  title="Samudhra Water Programs | Initiatives & Community Drives"
  description="Discover Samudhra Water Solutions programs including Clean School Water, Community Borewell Drives, Zero Wastewater Recycling, and Water Audits across Kerala."
  canonicalUrl={Astro.url.href}
>
  <Navbar />

  <!-- HERO HEADER -->
  <section class="bg-[#FAF9F6] text-slate-900 pt-28 sm:pt-36 pb-16 sm:pb-20 border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <span class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-[0.35em] text-[#07bee8] block mb-3">
        SUSTAINABLE WATER INITIATIVES
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[#024095] uppercase leading-tight max-w-4xl mx-auto">
        Samudhra Water Purification &amp; Community Programs
      </h1>
      <p class="text-sm sm:text-lg text-slate-600 font-light mt-6 max-w-2xl mx-auto leading-relaxed">
        Engineered water treatment programs for schools, communities, residential complexes, and industrial facilities across Kerala.
      </p>
    </div>
  </section>

  <!-- PROGRAM LIST SECTION -->
  <section class="py-16 sm:py-24 bg-[#FAF9F6] border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {programs.map((prog) => (
          <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 bg-[#024095]/10 text-[#024095] text-[10px] font-black uppercase tracking-wider rounded-full">
                  {prog.tag}
                </span>
                <span class="text-xs font-bold text-[#07bee8]">ISO 9001:2015</span>
              </div>
              <h3 class="text-xl font-black text-[#024095] uppercase tracking-tight mb-3">{prog.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 font-light leading-relaxed mb-6">{prog.description}</p>
              
              <div class="space-y-2 border-t border-slate-100 pt-4 mb-6">
                {prog.highlights.map((h) => (
                  <div class="flex items-center gap-2 text-xs font-bold text-slate-800">
                    <svg class="w-4 h-4 text-[#07bee8]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                    <span>{h}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-2">
              <a href="/contact" class="w-full inline-flex items-center justify-center min-h-[44px] bg-[#024095] hover:bg-[#07bee8] text-white text-xs font-black uppercase tracking-wider rounded-xl transition-colors shadow">
                Enroll / Inquire About Program
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGRAM ENROLLMENT & CONSULTATION -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-6">
      <span class="text-[10px] font-mono text-[#07bee8] font-extrabold uppercase tracking-[0.3em]">PARTNER WITH SAMUDHRA</span>
      <h2 class="text-2xl sm:text-4xl font-black text-[#024095] uppercase leading-tight">
        Bring a Water Purification Program to Your Community or School
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 font-light leading-relaxed max-w-2xl mx-auto">
        Contact our program coordinator team to request a free site water audit and program proposal for your institution or Panchayath.
      </p>
      <div class="pt-4 flex justify-center gap-4">
        <a href="/contact" class="px-8 py-3.5 bg-[#024095] text-white font-black text-xs uppercase tracking-widest rounded-xl hover:bg-[#07bee8] transition-all shadow-md">
          Request Program Proposal
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
