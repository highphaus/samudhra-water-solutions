---
// src/pages/program.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Samudhra Events & Annual Programs | State Awards & Celebrations"
  description="Explore Samudhra Water Solutions annual meets, state award distribution ceremonies, MSME Day honors, and annual family celebrations."
  canonicalUrl={Astro.url.href}
>
  <Navbar />

  <!-- HERO HEADER -->
  <section class="bg-[#FAF9F6] text-slate-900 pt-28 sm:pt-36 pb-16 sm:pb-20 border-b border-slate-200/60 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center relative z-10">
      <span class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-[0.35em] text-[#07bee8] block mb-3">
        ANNUAL MEETS &amp; STATE CELEBRATIONS
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[#024095] uppercase leading-tight max-w-4xl mx-auto">
        Samudhra Events, Annual Meets &amp; State Honors
      </h1>
      <p class="text-sm sm:text-lg text-slate-600 font-light mt-6 max-w-2xl mx-auto leading-relaxed">
        Commemorating leadership excellence, state industry awards, annual family meets, and employee prize distribution ceremonies at Samudhra Water Solutions.
      </p>
    </div>
  </section>



  <!-- FEATURED PROGRAM VIDEOS SHOWCASE (2 VIDEOS) -->
  <section class="py-16 sm:py-24 bg-white border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-left mb-12 max-w-3xl">
        <span class="text-xs font-mono text-[#07bee8] font-black uppercase tracking-[0.25em] block mb-2">EVENT &amp; CEREMONY HIGHLIGHTS</span>
        <h2 class="text-3xl font-black text-[#024095] uppercase tracking-tight">
          Watch Our Annual Events &amp; <span class="text-[#07bee8]">State Awards</span>
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-3 font-light leading-relaxed">
          Watch video highlights from Samudhra Sangamam annual family meets, employee excellence prize distributions, and state award ceremonies.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
        
        <!-- Video 1 Card -->
        <div class="bg-[#FAF9F6] rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-md flex flex-col justify-between">
          <div>
            <div class="flex justify-center mb-6">
              <div class="relative w-full max-w-[320px] aspect-[9/16] rounded-2xl overflow-hidden border-2 border-slate-200 shadow-xl bg-black">
                <iframe 
                  class="w-full h-full"
                  src="https://www.youtube.com/embed/3GvK3hj1IcU" 
                  title="Samudhra Sangamam Video" 
                  frameborder="0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                  allowfullscreen
                ></iframe>
              </div>
            </div>
            <div>
              <span class="text-[10px] font-mono text-[#07bee8] font-bold uppercase tracking-wider block mb-1">ANNUAL MEET &amp; CELEBRATION</span>
              <h3 class="text-lg font-black text-[#024095] uppercase tracking-tight">Samudhra Sangamam</h3>
              <p class="text-xs text-slate-600 font-light leading-relaxed mt-2">
                Live video highlights from Samudhra Sangamam — our annual family meet, employee excellence prize distribution, and milestone celebration.
              </p>
            </div>
          </div>
          <div class="pt-6 border-t border-slate-200/60 mt-6">
            <a href="/contact" class="w-full inline-flex items-center justify-center min-h-[44px] bg-[#024095] hover:bg-[#07bee8] text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all shadow-md active:scale-95">
              Connect For Event Inquiries &rarr;
            </a>
          </div>
        </div>

        <!-- Video 2 Card -->
        <div class="bg-[#FAF9F6] rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-md flex flex-col justify-between">
          <div>
            <div class="flex justify-center mb-6">
              <div class="relative w-full max-w-[320px] aspect-[9/16] rounded-2xl overflow-hidden border-2 border-slate-200 shadow-xl bg-black">
                <iframe 
                  class="w-full h-full"
                  src="https://www.youtube.com/embed/zWQ1ebqSS7w" 
                  title="🏆 അംഗീകാരത്തിന്റെ അഭിമാന നിമിഷം!" 
                  frameborder="0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                  allowfullscreen
                ></iframe>
              </div>
            </div>
            <div>
              <span class="text-[10px] font-mono text-[#07bee8] font-bold uppercase tracking-wider block mb-1">MSME DAY AWARD 2026</span>
              <h3 class="text-lg font-black text-[#024095] tracking-tight">🏆 അംഗീകാരത്തിന്റെ അഭിമാന നിമിഷം!</h3>
              <p class="text-xs text-slate-600 font-light leading-relaxed mt-2">
                Mr. Rajesh Kumar V K, Managing Director of Samudhra Water Solutions, was conferred the MSME Day Award 2026 by KSSIA in recognition of his outstanding dedication, technological innovation, and sustainable employment generation across Kerala.
              </p>
            </div>
          </div>
          <div class="pt-6 border-t border-slate-200/60 mt-6">
            <a href="/contact" class="w-full inline-flex items-center justify-center min-h-[44px] bg-[#024095] hover:bg-[#07bee8] text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all shadow-md active:scale-95">
              Connect For Event Inquiries &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>



  <!-- LIGHTBOX MODAL -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 transition-opacity duration-300">
    <button 
      id="lightbox-close" 
      class="absolute top-4 right-4 sm:top-6 sm:right-6 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 rounded-full p-3 transition-all z-10"
      aria-label="Close modal"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <div class="max-w-4xl max-h-[90vh] flex flex-col items-center justify-center">
      <img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-full object-contain rounded-xl shadow-2xl" />
      <p id="lightbox-caption" class="text-white/90 text-xs sm:text-sm font-semibold mt-4 text-center tracking-wide bg-slate-900/80 px-6 py-2 rounded-full border border-white/10"></p>
    </div>
  </div>

  <script is:inline>
    function openLightbox(src, caption) {
      const modal = document.getElementById('lightbox-modal');
      const img = document.getElementById('lightbox-img');
      const cap = document.getElementById('lightbox-caption');
      if (modal && img && cap) {
        img.src = src;
        cap.textContent = caption;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('lightbox-modal');
      const closeBtn = document.getElementById('lightbox-close');
      if (closeBtn && modal) {
        closeBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        });
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }
        });
      }
    });
  </script>

  <Footer />
</Layout>


