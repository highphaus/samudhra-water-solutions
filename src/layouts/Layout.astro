      </div>

      <!-- Chat Input Form -->
      <form id="chat-input-form" class="p-2.5 sm:p-3 bg-white border-t border-slate-100 flex gap-2 items-center flex-shrink-0">
        <input 
          type="text" 
          id="chat-user-input"
          placeholder="Ask a question or describe problem..."
          class="flex-1 px-3 py-2 bg-slate-100 text-slate-800 text-[11px] sm:text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#024095]/50 border border-transparent focus:bg-white transition-all"
          required
        />
        <button type="submit" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#024095] text-white hover:bg-[#07bee8] hover:scale-105 transition-all flex items-center justify-center shrink-0 shadow-md" aria-label="Send Message">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white fill-current pl-0.5" viewBox="0 0 24 24">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
          </svg>
        </button>
      </form>
    </div>

    <!-- FLOATING BOTTOM-RIGHT ACTION BUTTONS (Down by Down Stack: 1. Chatbot -> 2. Phone Call -> 3. WhatsApp) -->
    <div class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-[9999] flex flex-col items-center gap-3 pointer-events-auto">

      <!-- 1. TOP: AI Chatbot Button -->
      <div class="relative group flex items-center">
        <span class="hidden sm:block absolute right-16 bg-[#024095] text-white text-[9px] font-black uppercase tracking-widest px-3 py-2 rounded-lg shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap pointer-events-none border border-white/10">
          AI Help Desk
        </span>
        <button
          id="chat-toggle-btn"
          type="button"
          class="w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-tr from-[#024095] to-[#07bee8] text-white hover:shadow-xl hover:scale-110 active:scale-95 transition-all duration-300 flex items-center justify-center rounded-full relative shadow-2xl border-2 border-white cursor-pointer"
          aria-label="Open Water Solutions Assistant Chatbot"
        >
          <svg class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>
