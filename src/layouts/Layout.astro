            answer: "Low purifier pressure or slow water flow is usually due to a choked pre-filter candle, a scaled membrane, or pump issues.<br/><br/>👉 <strong>Troubleshoot:</strong> Check if your feed water valve is open, or request a technician service call via WhatsApp."
          },
          {
            keywords: ["replace", "filter change", "spare parts", "maintenance", "service interval", "membranes", "carbon"],
            answer: "Pre-filters should be changed every 9-12 months. RO membranes last 1.5-2 years. We stock genuine multibrand spares (filters, membranes, pumps)."
          },
          {
            keywords: ["contact", "phone", "location", "address", "poojappura", "trivandrum", "office", "call", "where", "number"],
            answer: "📍 <strong>Office Location:</strong> Poojappura, Thiruvananthapuram, Kerala.<br/>📞 <strong>Call Support:</strong> +91 96458 30994<br/><br/>👉 <strong>Hub:</strong> View details in our <a href='/contact' class='text-[#024095] font-black underline hover:text-[#07bee8]'>Contact Hub</a>."
          }
        ];

        function findBestAnswer(query: string) {
          const cleanQuery = query.toLowerCase().replace(/[^\w\s]/g, "");
          const words = cleanQuery.split(/\s+/).filter(w => w.length > 2);

          let bestMatch = null;
          let maxScore = 0;

          for (const entry of kb) {
            let score = 0;
            for (const word of words) {
              for (const kw of entry.keywords) {
                if (kw === word) {
                  score += 3;
                } else if (kw.includes(word) || word.includes(kw)) {
                  score += 1.2;
                }
              }
            }
            if (score > maxScore) {
              maxScore = score;
              bestMatch = entry;
            }
          }

          if (maxScore >= 1.2 && bestMatch) {
            return bestMatch.answer;
          }

          return "I'm Samudhra's local assistant bot! 💧 I couldn't find a direct match. Here are common topics you can search or ask:<br/><br/>" +
                 "• <strong>Iron Removal</strong> (metallic taste, yellow water)<br/>" +
                 "• <strong>Hard Water</strong> (scale buildup, softeners)<br/>" +
                 "• <strong>Domestic Purifiers</strong> (Aqua C3 models)<br/>" +
                 "• <strong>RO Plants</strong> (commercial filtration plants)<br/>" +
                 "• <strong>Free Water Test</strong> (on-site quality analysis)<br/><br/>" +
                 "Or message our support directly via <a href='https://wa.me/919645830994' target='_blank' class='text-[#024095] font-black underline hover:text-[#07bee8]'>WhatsApp Helpdesk</a>.";
        }

        function appendMessage(sender: 'bot' | 'user', text: string) {
          if (!messagesContainer) return;
          const msgDiv = document.createElement('div');
          if (sender === 'bot') {
            msgDiv.className = "bg-slate-100 text-slate-800 text-[11px] sm:text-xs max-w-[85%] rounded-2xl rounded-tl-none p-3 shadow-sm leading-relaxed self-start";
          } else {
            msgDiv.className = "bg-[#024095] text-white text-[11px] sm:text-xs max-w-[85%] rounded-2xl rounded-tr-none p-3 shadow-sm leading-relaxed self-end";
          }
          msgDiv.innerHTML = text;
          messagesContainer.appendChild(msgDiv);
          messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function handleUserSubmit(text: string) {
          if (!text.trim()) return;
          appendMessage('user', text);

          if (!messagesContainer) return;
          const typingDiv = document.createElement('div');
          typingDiv.className = "bg-slate-100 text-slate-400 text-[10px] max-w-[50px] rounded-xl rounded-tl-none px-3 py-2 shadow-sm self-start flex items-center gap-1 typing-indicator";
          typingDiv.innerHTML = "<span class='w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce'></span><span class='w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce [animation-delay:0.2s]'></span><span class='w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce [animation-delay:0.4s]'></span>";
          messagesContainer.appendChild(typingDiv);
          messagesContainer.scrollTop = messagesContainer.scrollHeight;

          setTimeout(() => {
            const indicator = messagesContainer.querySelector('.typing-indicator');
            if (indicator) indicator.remove();

            const answer = findBestAnswer(text);
            appendMessage('bot', answer);
          }, 600);
        }

        function toggleChatWindow() {
          if (!chatWin) return;
          const isHidden = chatWin.classList.contains('hidden');
          if (isHidden) {
            chatWin.classList.remove('hidden');
            if (notifBadge) notifBadge.remove();
            if (messagesContainer) messagesContainer.scrollTop = messagesContainer.scrollHeight;
          } else {
            chatWin.classList.add('hidden');
          }
        }

        toggleBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleChatWindow();
        });

        closeBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (chatWin) chatWin.classList.add('hidden');
        });

        inputForm?.addEventListener('submit', (e) => {
          e.preventDefault();
          if (userInput) {
            const text = userInput.value;
            userInput.value = '';
            handleUserSubmit(text);
          }
        });

        quickBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const queryText = btn.textContent?.trim() || '';
            handleUserSubmit(queryText);
          });
        });

        document.addEventListener('click', (e) => {
          const target = e.target as Node;
          if (chatWin && !chatWin.contains(target) && toggleBtn && !toggleBtn.contains(target)) {
            chatWin.classList.add('hidden');
          }
        });
      })();
