        </button>
      </div>

      <!-- 2. MIDDLE: Phone Call Button (+91 96458 30994) -->
      <div class="relative group flex items-center">
        <span class="hidden sm:block absolute right-16 bg-[#024095] text-white text-[9px] font-black uppercase tracking-widest px-3 py-2 rounded-lg shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap pointer-events-none border border-white/10">
          Call Now
