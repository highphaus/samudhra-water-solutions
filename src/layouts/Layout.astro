        <a
          href="tel:+919645830994"
          class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-gradient-to-br from-[#024095] to-[#07bee8] text-white shadow-2xl border-2 border-white flex items-center justify-center hover:scale-110 active:scale-95 transition-all duration-300 cursor-pointer"
          aria-label="Call Support +91 96458 30994"
          title="Call Support +91 96458 30994"
        >
